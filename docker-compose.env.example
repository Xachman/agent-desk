# Docker Compose development environment overrides.
# Copy this file to .env and adjust as needed.

APP_PORT=8000
VITE_PORT=5173
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

APP_URL=http://localhost:8000

# Slack development settings (use a public tunnel like ngrok/localtunnel for these)
SLACK_OAUTH_REDIRECT_URL=http://localhost:8000/slack/oauth/callback
SLACK_AGENT_CALLBACK_URL=http://localhost:8000/slack/agent/callback
